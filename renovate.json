{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "dockerfile",
    "pip-compile",
    "pip_requirements"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    ".github/cosign/**",
    "container/requirements-build.lock",
    "requirements-build.lock"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "/^container/[^/]+$/"
      ],
      "schedule": [
        "at any time"
      ]
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "/^container/[^/]+$/"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "<3.12"
    },
    {
      "description": "Regenerate compiled locks with their recorded source command; avoid independent edits to inputs or output snapshots.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "container/requirements-runtime.in",
        "container/requirements-runtime.lock",
        "requirements-firmware.lock",
        "requirements-firmware.txt"
      ],
      "enabled": false
    },
    {
      "description": "These generated locks use compile flags unsupported by the pinned Renovate parser; regenerate them through the documented source workflow.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "container/requirements-build.lock",
        "requirements-build.lock"
      ],
      "enabled": false
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)([^/]*[-_])?requirements[^/]*\\.(txt|pip)$/"
    ],
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      "**/tools/browser-compatibility/**",
      ".github/cosign/**",
      "container/requirements-build.lock",
      "requirements-build.lock",
      "container/requirements-runtime.in",
      "container/requirements-runtime.lock",
      "requirements-firmware.lock",
      "requirements-firmware.txt"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^container/requirements\\-runtime\\.lock$/",
      "/^requirements\\-firmware\\.lock$/"
    ]
  }
}
